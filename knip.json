{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "treatConfigHintsAsErrors": false,
  "ignoreDependencies": ["@commitlint/cli"],
  "ignore": [
    "commitlint-plugin-no-external-refs.cjs",
    "src/plugins/blog/generated/**"
  ],
  "entry": ["src/scripts/print-slash-commands.ts!"],
  "project": [
    "*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}",
    "{[!s]*,s[!r]*,s,sr[!c]*,sr,src?*}/**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}",
    "src/**/*.{js,cjs,mjs,jsx,ts,cts,mts,tsx}!",
    "!src/**/_test-utils.ts!",
    "!src/**/*.test.ts!"
  ]
}
