{
  "name": "slack-bot",
  "private": true,
  "packageManager": "pnpm@12.4.0",
  "type": "module",
  "imports": {
    "#*": "./src/*.ts"
  },
  "scripts": {
    "start": "node --import @fohte/service-kit/otel-register dist/index.js",
    "build": "tsup",
    "lint": "eslint .",
    "format:eslint": "eslint --fix .",
    "format:prettier": "prettier --write .",
    "format": "conc -m 1 pnpm:format:eslint pnpm:format:prettier",
    "test": "conc pnpm:test:type pnpm:test:unit",
    "test:type": "tsc --noEmit",
    "test:unit": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "dev": "tsx watch --import @fohte/service-kit/otel-register src/index.ts",
    "print-slash-commands": "tsx src/scripts/print-slash-commands.ts",
    "generate:blog-publisher-contract": "openapi-zod-client https://raw.githubusercontent.com/fohte/blog-publisher/main/openapi.json -o src/plugins/blog/generated/blog-publisher-contract.ts -t src/plugins/blog/blog-publisher-contract.template.hbs --export-schemas"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@fohte/eslint-config": "0.4.4",
    "@ninoseki/eslint-plugin-neverthrow": "0.3.1",
    "@opentelemetry/context-async-hooks": "2.11.0",
    "@opentelemetry/core": "2.11.0",
    "@tsconfig/node-lts": "24.0.1",
    "@tsconfig/strictest": "2.0.8",
    "@types/node": "24.13.3",
    "concurrently": "10.0.5",
    "drizzle-kit": "0.31.10",
    "eslint": "10.10.0",
    "eslint-plugin-simple-import-sort": "13.0.0",
    "openapi-zod-client": "1.18.3",
    "pino-pretty": "13.1.3",
    "knip": "6.35.0",
    "prettier": "3.9.6",
    "tsup": "8.5.1",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@a2a-js/sdk": "0.3.14",
    "@fohte/service-kit": "0.1.14",
    "@hono/node-server": "2.0.12",
    "@langchain/core": "1.2.9",
    "@langchain/langgraph": "1.4.14",
    "@langchain/langgraph-checkpoint-postgres": "1.0.5",
    "@langchain/mcp-adapters": "1.1.4",
    "@langchain/openai": "1.5.11",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/sdk-metrics": "2.11.0",
    "@opentelemetry/sdk-trace-base": "2.11.0",
    "@slack/web-api": "7.19.0",
    "drizzle-orm": "0.45.2",
    "hono": "4.12.34",
    "langchain": "1.5.10",
    "neverthrow": "8.2.0",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "zod": "4.4.3"
  }
}
